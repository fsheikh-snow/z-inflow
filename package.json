{
    "name": "z-inflow",
    "version": "0.0.1",
    "description": "",
    "license": "UNLICENSED",
    "imports": {
        "#now:*": "./@types/servicenow/fluent/*/index.js"
    },
    "scripts": {
        "build": "now-sdk build",
        "pack": "now-sdk pack",
        "deploy": "cp now.config.zscaler-ppm.json now.config.json && now-sdk install",
        "deploy:cursor": "node scripts/check-now-config.mjs && now-sdk install --auth sdk-ai-admin",
        "deploy:zscaler-ppm": "cp now.config.zscaler-ppm.json now.config.json && now-sdk install",
        "deploy:ppm": "cp now.config.zscaler-ppm.json now.config.json && now-sdk install",
        "deploy:zflow": "cp now.config.zflow.json now.config.json && now-sdk install",
        "prep:install": "node scripts/strip-deleted-keys.mjs && npm run build",
        "set-scope": "node scripts/set-scope.mjs",
        "transform": "now-sdk transform",
        "types": "now-sdk dependencies",
        "dev": "now-sdk run dev",
        "audit:modules": "node scripts/audit-server-modules.mjs",
        "smoke": "npm run audit:modules && node scripts/smoke-test.mjs",
        "ship": "npm run audit:modules && npm run build && npm run deploy && npm run smoke"
    },
    "devDependencies": {
        "@servicenow/sdk": "4.10.1",
        "@servicenow/glide": "27.0.5",
        "@servicenow/isomorphic-rollup": "^1.3.7"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@tanstack/react-query": "^5.85.5",
        "@tanstack/react-virtual": "^3.13.12",
        "react": "19.x",
        "react-dom": "19.x",
        "react-router-dom": "^7.8.2",
        "recharts": "^3.1.2"
    }
}
